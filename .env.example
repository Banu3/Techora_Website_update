# TECHORA Consultant — Environment Configuration Template
# Copy this file to .env and configure for your environment

# Server Configuration
PORT=5000
NODE_ENV=development

# Security & JWT Configuration (Used for admin JWT tokens)
JWT_SECRET=techora_jwt_secret_key_2026_institutional_portal_production
ADMIN_TOKEN=techora_admin_secret_token_2026

# Administrative Default Login Credentials:
# Email: admin@techora.consulting
# Password: Admin@123

# Database Configuration
DATABASE_PATH=./data/techora.sqlite
# If deploying on PostgreSQL with Prisma:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techora?schema=public

# Optional LLM Key for Enhanced Resume Extraction (Strict JSON schema)
# If left empty, the built-in intelligent multi-tier regex/heuristic parser is used automatically
GEMINI_API_KEY=
OPENAI_API_KEY=

# Client Site URL for Canonical & CORS
CLIENT_URL=http://localhost:3000

# Email / SMTP Configuration (Optional - logs to console if unconfigured)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@techora.consulting
SMTP_PASS=example_smtp_password_here
NOTIFY_TO=partnerships@techora.consulting
MAIL_FROM="TECHORA Mandate Desk" <no-reply@techora.consulting>
